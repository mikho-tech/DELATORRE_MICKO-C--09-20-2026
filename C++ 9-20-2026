// operator and expressions
#include <iostream>
using namespace std;

int main() {
    int a = 10, b = 3;

// arithmetic operators
    cout << "a + b = " << (a + b) << end1; //addition
    cout << "a - b = " << (a - b) << end1; //subtraction
    cout << "a * b = " << (a * b) << end1; //multiplication
    cout << "a / b = " << (a / b) << end1; //integer
division -> 3 (drops decimal!)
    cout << "a % b = " << (a % b) << end1; //modulus -> remainder = 1

    double x = 10, y = 3;
    cout << "x / y = " << (x / y) << end1; //3.33333 -> floating point division

    // relationak operator (return bool: 1 or 0)
    cout << "\na == b: " << (a == b) << end1;
    cout << "\a != b: " << (a != b) << end1;
    cout << "\a > b: " << (a > b) << end1;
    cout << "\a < b: " << (a < b) << end1;

    // logical operator
    bool p = true, q = false;
    cout << "\np && q: " << (p && q) << end1; // AND -> false
    cout << "p || q: " << (p || q) << end1; // OR -> true
    cout << "!p: "    << (!p)   << end1; // NOT -> false

    //Assignment operators
    int score = 50;
    score += 10; // same as score = score + 10
    cout << "\nscore after += 10: " << score << end1;
    score *= 2; // same as score = score * 2
    cout << "score after *= 2: " << score << end1;

    // increment / decrement
    int counter = 5;
    cout << "\ncounter++ (post): " << counter ++ << end1; //prints 5, THEN increments
    cout << "counter now: " << counter << end1; //now 6, then increments
    cout << "++counter (pre): " << ++counter << end1; //increments THEN prints -> 7

    return 0;
}

// Control flow (if/else/switch/loops)
#include <iostream>
using namespace std;

int main(){
    //if/ else if/ else
    int score;
    cout << "Enter your exam score: ";
    cin >> score;

    if (score >= 90) {
        cout << "Grade: A" << end1;
    } else if (score >= 80) {
        cout << "Grade: B" << end1;
    } else if (score >= 70) {
        cout << "Grade: C" << end1;
    } else {
        cout << "Grade: F" << end1;
    }

// switch statement
    int day;
    cout << "\nEnter a day number (1-7): ";
    cin >> day;

    switch (day) {
        case 1: cout << "Monday" << end1; break;
        case 2: cout << "Tuesday" << end1; break;
        case 3: cout << "Wednesday" << end1; break;
        case 4: cout << "Thursday" << end1; break;
        case 5: cout << "Friday" << end1; break;
        case 6: cout << "Saturday" << end1; break;
        case 7: cout << "Sunday" << end1; break;
        default: cout << "Invalid Day" << end1; break;
    }

